# Variables de entorno del proyecto. Copia este archivo a .env y
# completa los valores reales (nunca subas .env a git).

# Usado por services/agenda/main.py (Semantic Kernel, conector
# OpenAI-compatible). Si no se define, se usa un razonador mock (costo
# cero, sin llamadas de red).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL_ID=openai/gpt-oss-120b
# Base URL del endpoint OpenAI-compatible (OpenAI, Groq, Azure AI, LM
# Studio, Ollama con proxy OpenAI, etc.).
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Usado por frontend/app.py (ChatGroq / LangGraph). Consigue una key
# gratuita en https://console.groq.com/keys
GROQ_API_KEY=
